
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup All Services",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Setup Frontend",
        "Setup User Service",
        "Setup POI Service",
        "Setup Audio Service",
        "Setup Offline Package Service"
      ],
      "problemMatcher": []
    },
    {
      "label": "Setup Frontend",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Setup User Service",
      "type": "shell",
      "command": "if (!(Test-Path '.venv/Scripts/python.exe')) { python -m venv .venv }; & '.venv/Scripts/python.exe' -m pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend/user-service",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Setup POI Service",
      "type": "shell",
      "command": "if (!(Test-Path '.venv/Scripts/python.exe')) { python -m venv .venv }; & '.venv/Scripts/python.exe' -m pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend/poi-service",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Setup Audio Service",
      "type": "shell",
      "command": "if (!(Test-Path '.venv/Scripts/python.exe')) { python -m venv .venv }; & '.venv/Scripts/python.exe' -m pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend/audio-service",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Setup Offline Package Service",
      "type": "shell",
      "command": "if (!(Test-Path '.venv/Scripts/python.exe')) { python -m venv .venv }; & '.venv/Scripts/python.exe' -m pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend/offline-package-service",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Start All Services",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Start Frontend",
        "Start User Service",
        "Start POI Service",
        "Start Audio Service",
        "Start Offline Package Service"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start User Service",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8001",
      "options": {
        "cwd": "${workspaceFolder}/backend/user-service"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start POI Service",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8002",
      "options": {
        "cwd": "${workspaceFolder}/backend/poi-service"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Audio Service",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8003",
      "options": {
        "cwd": "${workspaceFolder}/backend/audio-service"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Offline Package Service",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8004",
      "options": {
        "cwd": "${workspaceFolder}/backend/offline-package-service"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
